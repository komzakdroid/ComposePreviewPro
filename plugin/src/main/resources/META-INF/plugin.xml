<idea-plugin require-restart="true">
    <!-- require-restart="true": force a full IDE restart on install,
         update, and uninstall. This plugin is NOT safely dynamic — it
         spawns a long-lived out-of-process renderer (Compose Desktop +
         Skiko native libraries) and loads a JVM agent. Hot-swapping the
         plugin classloader without a restart leaves a stale renderer
         subprocess holding the old bundled `renderer/` dir + native libs,
         which is exactly the kind of cached half-state that produces
         "Renderer launcher not found" after an in-place update. A restart
         guarantees the bundled renderer path is re-resolved against the
         freshly-unpacked plugin directory. -->

    <!-- id, name, vendor, description, change-notes, version, and
         idea-version are populated by the
         `intellijPlatform { pluginConfiguration { … } }` block in
         build.gradle.kts. The Gradle plugin patches them into this file
         at packaging time. Declaring them in both places causes a
         warning ("element already defined"), so we keep ONLY the wiring
         (depends + extensions) here. -->

    <!-- ─────────────────────────────────────────────────────────────
         Remote Dev / JetBrains Gateway status (May 2026):

         This plugin uses the legacy single-descriptor Plugin Model V1.
         In split mode, the platform falls back to loading it on the
         BACKEND host only — the tool window will not appear in a
         JetBrains Client connected to a remote backend.

         The PNG-streaming render path is inherently remote-dev-friendly
         (out-of-process subprocess on the backend, PNG bytes shipped to
         the frontend via the existing tool-window content RPC); the
         Live-UI mode is not, because ComposePanel needs a display
         server which the backend host typically lacks.

         Proper support requires Modular Plugin V2 with at least
         `shared` + `frontend` content modules — ToolWindowFactory and
         the Compose-Desktop-bearing UI live in the frontend module,
         the GradleCompiler + PSI inspection + RendererProcess service
         live in shared/backend. Scheduled for the 0.4.x architectural
         refactor. Tracking against the JetBrains modular plugin
         template: https://github.com/JetBrains/intellij-platform-modular-plugin-template
         ─────────────────────────────────────────────────────────── -->

    <!-- Platform module gives us the basic IDE plugin API.
         Kotlin plugin gives PSI access to @Composable functions in .kt files.
         Java module is required transitively by Kotlin's PSI in current IDEs. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Line marker = the ▶ icon shown in the editor gutter beside every
             @Composable function declaration. -->
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="com.composepreviewpro.plugin.marker.ComposableLineMarkerProvider"/>

        <!-- Right-side tool window that hosts the rendered preview panel. -->
        <toolWindow
            id="ComposePreview"
            anchor="right"
            secondary="false"
            factoryClass="com.composepreviewpro.plugin.toolwindow.PreviewToolWindowFactory"/>

        <!-- Project-scoped service: one PreviewService per opened project,
             holds the active renderer process and the panel reference. -->
        <projectService
            serviceImplementation="com.composepreviewpro.plugin.service.PreviewService"/>
    </extensions>

    <!-- Declare compatibility with BOTH Kotlin plugin modes:
           • K1 — legacy frontend (still default on many IDEs / Android Studio).
           • K2 — new analysis API frontend, default on IDEA 2024.3+ and
                   Android Studio Hedgehog / Iguana K2-mode opt-in.

         Our PSI usage (KtCallExpression, mainReference.resolve, KtPsiFactory,
         KtTreeVisitorVoid) is built on common Kotlin PSI which works
         identically under both modes — we do NOT depend on any K1-only
         resolve API (BindingContext, DescriptorUtils, etc.). The same code
         path drives parameter-name resolution and PSI write-back in either
         mode, so explicitly declaring "supportsK2=true" is correct.

         Without this declaration, the Kotlin plugin defaults to "K1 only"
         and shows the plugin as incompatible when the user is on K2 mode —
         which is what the user reported on Android Studio. -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>
</idea-plugin>
